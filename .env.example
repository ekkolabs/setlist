# Password that unlocks the edit view (server-side only; never shipped to the browser)
EDIT_PASSWORD=change-me

# Secret used to sign the edit-session cookie. Any long random string,
# e.g. `openssl rand -hex 32`.
AUTH_SECRET=change-me-to-a-long-random-string

# Neon Postgres connection string (pooled). Provided by the Vercel Neon integration.
# For local dev, copy from your Neon dashboard or `vercel env pull .env.local`.
DATABASE_URL=
